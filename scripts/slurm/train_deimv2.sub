#!/bin/bash
# DEIMv2 on a Purdue RCAC GPU cluster (Gilbreth / Gautschi).
#
#   sbatch scripts/slurm/train_deimv2.sub
#   sbatch --export=ALL,ARCH=hgnetv2_pico,RESOLUTION=640,RUN_NAME=dv2_pico_640 \
#          scripts/slurm/train_deimv2.sub
#
# Submit from the project root. Mirrors train.sub / train_rfdetr.sub so all
# three models are trained under the same walltime/chaining/staging policy -
# otherwise the comparison picks up a difference that has nothing to do with
# the architecture.

#SBATCH --job-name=cone-deimv2
#SBATCH --account=CHANGE_ME            # `slist` shows what you can charge
#SBATCH --partition=CHANGE_ME          # your PI queue, or `standby` (4 h cap)
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=12
#SBATCH --mem=96G                      # transformer activations at 1280
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --mail-type=BEGIN,END,FAIL

##SBATCH --constraint=A100             # `sfeatures` lists node features
##SBATCH --gres=gpu:4                  # then set DEVICES=4

set -euo pipefail

# ---- knobs ---------------------------------------------------------------
PROJECT="${SLURM_SUBMIT_DIR:-$PWD}"
MODEL_DIR="deimv2"
ARCH="${ARCH:-hgnetv2_n}"              # hgnetv2_{atto,femto,pico,n,s,m,l,x} | dinov3_{s,m,l,x}
RESOLUTION="${RESOLUTION:-1280}"       # %32 for every DEIMv2 variant
RUN_NAME="${RUN_NAME:-dv2_n_1280}"
EPOCHS="${EPOCHS:-0}"                  # 0 = the variant's own tuned schedule
BATCH="${BATCH:-0}"                    # TOTAL across GPUs; 0 = config default
LR="${LR:-0}"                          # 0 = config default
DEVICES="${DEVICES:-1}"
TUNING="${TUNING:-}"                   # COCO checkpoint to fine-tune from
NO_PHOTOMETRIC="${NO_PHOTOMETRIC:-0}"  # 1 = drop RandomPhotometricDistort
CONDA_ENV="${CONDA_ENV:-deimv2}"
DATA_ROOT="${DATA_ROOT:-$RCAC_SCRATCH/aks-cone-detection/data/merged_coco}"
export DEIMV2_HOME="${DEIMV2_HOME:-$RCAC_SCRATCH/DEIMv2}"
STAGE_LOCAL="${STAGE_LOCAL:-1}"
CHAIN="${CHAIN:-1}"
CHAIN_MAX="${CHAIN_MAX:-12}"
CHAIN_N="${CHAIN_N:-1}"
MASTER_PORT="${MASTER_PORT:-$((7000 + RANDOM % 1000))}"

cd "$PROJECT"
mkdir -p logs

echo "=================================================================="
echo " job    : ${SLURM_JOB_ID:-local}  (chain $CHAIN_N/$CHAIN_MAX)"
echo " node   : $(hostname)"
echo " run    : $RUN_NAME  deimv2_$ARCH @ $RESOLUTION"
echo " clone  : $DEIMV2_HOME"
echo "=================================================================="

# ---- environment ---------------------------------------------------------
module --force purge
module load modtree/gpu 2>/dev/null || true
module load conda
module load cuda || true
eval "$(conda shell.bash hook)"
conda activate "$CONDA_ENV"

export TORCH_HOME="$RCAC_SCRATCH/.torch"
export HF_HOME="$RCAC_SCRATCH/.hf"
export MPLCONFIGDIR="$RCAC_SCRATCH/.matplotlib"
mkdir -p "$TORCH_HOME" "$HF_HOME" "$MPLCONFIGDIR"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export WANDB_MODE=disabled

nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || true
python -c "import torch;print(f'torch {torch.__version__} cuda={torch.cuda.is_available()} n={torch.cuda.device_count()}')"

if [[ ! -f "$DEIMV2_HOME/train.py" ]]; then
  echo "[FATAL] no DEIMv2 clone at $DEIMV2_HOME" >&2
  echo "        run scripts/slurm/setup_deimv2_rcac.sh" >&2
  exit 1
fi

# ---- dataset -------------------------------------------------------------
# Same COCO mirror rf-detr uses; yolo_to_coco.py never re-splits.
if [[ ! -f "$DATA_ROOT/train/_annotations.coco.json" ]]; then
  echo "[FATAL] no COCO dataset at $DATA_ROOT" >&2
  echo "        run scripts/slurm/sync_to_rcac.sh, then scripts/yolo_to_coco.py" >&2
  exit 1
fi

DATA_ROOT_ORIG="$DATA_ROOT"
if [[ "$STAGE_LOCAL" == "1" && -n "${TMPDIR:-}" && -d "$TMPDIR" ]]; then
  LOCAL="$TMPDIR/cone_coco"
  echo "[stage] $DATA_ROOT -> $LOCAL"
  mkdir -p "$LOCAL"
  rsync -a --info=progress2 "$DATA_ROOT/" "$LOCAL/"
  DATA_ROOT="$LOCAL"
fi
echo "[data] $DATA_ROOT  (train=$(ls "$DATA_ROOT/train" | wc -l) files)"

# ---- resume --------------------------------------------------------------
# DEIMv2 writes last.pth into output_dir every epoch.
OUT="$PROJECT/$MODEL_DIR/runs/$RUN_NAME"
EXTRA=()
if [[ -f "$OUT/last.pth" ]]; then
  echo "[resume] found $OUT/last.pth"
  EXTRA+=(--resume "$OUT/last.pth")
elif [[ -n "$TUNING" ]]; then
  echo "[tuning] from $TUNING"
  EXTRA+=(--tuning "$TUNING")
fi
if [[ "$EPOCHS" != "0" ]]; then EXTRA+=(--epochs "$EPOCHS"); fi
if [[ "$BATCH"  != "0" ]]; then EXTRA+=(--batch "$BATCH"); fi
if [[ "$LR"     != "0" ]]; then EXTRA+=(--lr "$LR"); fi
if [[ "$NO_PHOTOMETRIC" == "1" ]]; then EXTRA+=(--no-photometric); fi

# ---- walltime margin so the tail always runs -----------------------------
MARGIN="${MARGIN:-900}"
if [[ -n "${SLURM_JOB_END_TIME:-}" ]]; then
  BUDGET=$(( SLURM_JOB_END_TIME - $(date +%s) - MARGIN ))
else
  BUDGET=$(( 4 * 3600 - MARGIN ))
fi
(( BUDGET < 300 )) && BUDGET=300
echo "[time] giving training ${BUDGET}s before graceful stop"

# ---- train ---------------------------------------------------------------
set +e
timeout --signal=INT "${BUDGET}" \
python scripts/train_deimv2.py \
  --arch        "$ARCH" \
  --dataset     "$DATA_ROOT" \
  --resolution  "$RESOLUTION" \
  --workers     "${SLURM_CPUS_PER_TASK:-8}" \
  --devices     "$DEVICES" \
  --device      cuda \
  --master-port "$MASTER_PORT" \
  --project     "$PROJECT/$MODEL_DIR/runs" \
  --name        "$RUN_NAME" \
  --notes       "rcac ${SLURM_JOB_ID:-local} $(hostname) chain=$CHAIN_N" \
  ${EXTRA[@]+"${EXTRA[@]}"}
RC=$?
set -e
echo "[train] exit $RC"

# ---- eval, or chain ------------------------------------------------------
BEST=""
for c in best_stg2.pth best_stg1.pth best.pth last.pth; do
  if [[ -f "$OUT/$c" ]]; then BEST="$OUT/$c"; break; fi
done

if [[ $RC -eq 0 && -n "$BEST" ]]; then
  echo "[eval] bucketed recall against $BEST"
  python scripts/eval_buckets.py --backend deimv2 --arch "$ARCH" \
    --weights "$BEST" --imgsz "$RESOLUTION" --run "$RUN_NAME" || true
  echo "[done] $BEST"
  exit 0
fi

if [[ "$CHAIN" == "1" ]] && { [[ -f "$OUT/last.pth" ]] || (( RC == 124 )); }; then
  if (( CHAIN_N < CHAIN_MAX )); then
    echo "[chain] out of walltime - resubmitting link $((CHAIN_N + 1))"
    sbatch --export=ALL,ARCH="$ARCH",RESOLUTION="$RESOLUTION",RUN_NAME="$RUN_NAME",\
EPOCHS="$EPOCHS",BATCH="$BATCH",LR="$LR",DEVICES="$DEVICES",TUNING="$TUNING",\
NO_PHOTOMETRIC="$NO_PHOTOMETRIC",DEIMV2_HOME="$DEIMV2_HOME",\
DATA_ROOT="$DATA_ROOT_ORIG",STAGE_LOCAL="$STAGE_LOCAL",\
CHAIN="$CHAIN",CHAIN_MAX="$CHAIN_MAX",CHAIN_N="$((CHAIN_N + 1))" \
      "$PROJECT/scripts/slurm/train_deimv2.sub"
    exit 0
  fi
  echo "[chain] hit CHAIN_MAX=$CHAIN_MAX without finishing" >&2
fi
exit $RC
